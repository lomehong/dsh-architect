{
  "name": "@dsh-extra/dsh-architect",
  "version": "0.3.0",
  "description": "架构师 Agent 的 dsh 宿主外壳：cordis 插件（服务 + 4 工具 architect_digest/design/review/lint）——校验与评分逻辑在 architect-core（宿主中立核心）",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    "0": {},
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./coverage": {
      "types": "./lib/types/coverage.d.ts",
      "default": "./lib/coverage.js"
    },
    "./digest": {
      "types": "./lib/types/digest.d.ts",
      "default": "./lib/digest.js"
    },
    "./lint": {
      "types": "./lib/types/lint.d.ts",
      "default": "./lib/lint.js"
    },
    "./kbcollect": {
      "types": "./lib/types/kbcollect.d.ts",
      "default": "./lib/kbcollect.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dependencies": {
    "architect-core": "file:../packages/architect-core"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
