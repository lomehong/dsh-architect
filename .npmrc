# @deepseek-ai rc packages have conflicting peers (workspace convention).
legacy-peer-deps=true
# architect-core 以 file: 依赖安装，其 prepare（tsc 构建 lib）须被允许，
# 否则 CI 干净环境里无 lib → 外壳 typecheck/build 链式失败（2026-09-11）。
allow-scripts=architect-core
# 发布与安装走国内镜像；GitHub Actions runner 会自动回退官方源（npmmirror 对 CI 亦可达）。
registry=https://registry.npmmirror.com
